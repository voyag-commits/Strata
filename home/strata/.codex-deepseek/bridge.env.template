# Strata DeepSeek Bridge environment template
# Copy to bridge.env and fill in real values. bridge.env is chmod 600, never committed.
# Path inside distro: /home/strata/.codex-deepseek/bridge.env

# DeepSeek upstream API key (required). Obtain from https://platform.deepseek.com
DEEPSEEK_API_KEY=

# Bridge auth key (required). A random secret clients use to authenticate to the local bridge.
# Generate one with: head -c 32 /dev/urandom | base64
BRIDGE_AUTH_KEY=

# Local bridge listen port. Default 38449 (must match deepseek_bridge.config.toml base_url).
PORT=38449

# Model + inference defaults (optional overrides)
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_ENABLE_THINKING=true
DEEPSEEK_REASONING_EFFORT=xhigh
