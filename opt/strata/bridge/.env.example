# Bridge configuration. The launcher reads these from your local secret store
# (~/.codex-deepseek/bridge.env), which is created by the installer / Set-DeepSeek-Key.ps1.
# This .example file documents every option. NEVER commit a real key.

# Your DeepSeek API key. Stays only in the bridge process environment.
DEEPSEEK_API_KEY=
# Local random token Codex sends to the bridge as the bearer (NOT the DeepSeek key).
# The installer generates one for you.
BRIDGE_AUTH_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
PORT=38441
# Optional: comma-separated model list returned by /v1/models.
DEEPSEEK_MODELS=deepseek-v4-pro,deepseek-v4-flash
# Optional: force every upstream request to DEEPSEEK_MODEL, useful if Codex sends a non-DeepSeek model slug.
DEEPSEEK_FORCE_MODEL=false
# Thinking is ON by default for DeepSeek V4. Set false for the fast non-thinking path.
DEEPSEEK_ENABLE_THINKING=true
# Default reasoning effort. Max gives best reasoning depth for coding tasks.
DEEPSEEK_REASONING_EFFORT=max
# Optional numeric reasoning-token budget, forwarded to DeepSeek as thinking.budget_tokens.
# NOTE: DeepSeek treats this as a soft hint, not a hard cap. Empty = none.
DEEPSEEK_THINKING_BUDGET=2000
# Optional: upstream DeepSeek timeout in milliseconds.
UPSTREAM_TIMEOUT_MS=120000
# Optional: one JSON line per upstream failure, for self-diagnosis (kind="upstream" vs "network").
BRIDGE_ERROR_LOG=
# Optional: full redacted request/response traces for deep debugging (large files).
BRIDGE_DEBUG_TRACE_DIR=

# NOTE: If you run a VPN / system proxy, Codex (not the bridge) may route its
# request to 127.0.0.1 through the proxy and get "502 Bad Gateway". The launcher
# handles this by setting NO_PROXY=localhost,127.0.0.1,::1 before starting Codex.
