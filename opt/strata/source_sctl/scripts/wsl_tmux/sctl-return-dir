#!/usr/bin/env bash
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" >/dev/null 2>&1 && pwd)"
# shellcheck source=_sctl_adapter_common.sh
source "$SCRIPT_DIR/_sctl_adapter_common.sh"
ASSIGNMENT_ID=""
ID=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --workspace) SCTL_WORKSPACE="$2"; shift 2 ;;
    --assignment-id) ASSIGNMENT_ID="$2"; shift 2 ;;
    --id|--session-id) ID="$2"; shift 2 ;;
    --help) echo "usage: sctl-return-dir --assignment-id A001 --id logical_session_id"; exit 0 ;;
    *) usage_error "unknown argument: $1" ;;
  esac
done
[ -n "$ASSIGNMENT_ID" ] || usage_error "--assignment-id required"
[ -n "$ID" ] || usage_error "--id required"
delegate return-dir --workspace "$SCTL_WORKSPACE" --assignment-id "$ASSIGNMENT_ID" --session-id "$ID"
